# BRADIX configuration for Andrew's MSI NUC. Copy to .env and chmod 600.
BRADIX_API_PORT=8080
BRADIX_PWA_PORT=80
BRADIX_API_URL=http://localhost:8080
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
OLLAMA_PORT=11434
OLLAMA_MODEL=nous-hermes2

# Notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=

# Tailscale (leave blank for manual login)
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=bradix-nuc
TAILSCALE_IP=

# Safety: keep false until outbound connectors are tested.
ALLOW_EXTERNAL_SEND=false
OUTBOUND_WEBHOOK_URL=
CORS_ORIGINS=*
